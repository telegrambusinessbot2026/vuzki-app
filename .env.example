# =====================================================================
# VUZKI - Root environment template (docker compose / full stack)
#
# Copy to .env and fill with real values per environment. NEVER commit .env.
# Provide a separate .env per environment (development / staging / production)
# and keep production credentials out of development environments.
#
# Secrets reference here are managed via a secret manager in production
# (e.g. AWS Secrets Manager / HashiCorp Vault) - see ARN_* placeholders.
# =====================================================================

# ---------------- Environment & Service -----------------
NODE_ENV=production
ENVIRONMENT=production            # development | staging | production
BUILD_ID=
LOG_LEVEL=info                    # debug | info | warn | error

# ---------------- Frontend/Web Service ---------------------------------
# Public (browser-safe) env vars for the Next.js web service (apps/web).
# Only NEXT_PUBLIC_* values are embedded in the browser bundle at build time.
# NEVER put DATABASE_URL, JWT_SECRET, OAuth/payment secrets or API keys here.
# The single web service hosts BOTH the website and the /app application.
NEXT_PUBLIC_APP_NAME=VUZKI
NEXT_PUBLIC_SITE_URL=https://vuzki.app
NEXT_PUBLIC_API_URL=https://vuzki-api.onrender.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://vuzki-api.onrender.com

# ---------------- PostgreSQL ------------------------------
# Private network only in production; never expose Postgres publicly.
# Use a least-privilege app user for the API, not the superuser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vuzki
POSTGRES_USER=vuzki
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=vuzki
# Encrypted backup destination (optional, used by scripts/backup.sh)
BACKUP_BUCKET=s3://vuzki-backups
BACKUP_RETENTION_DAYS=30

# ---------------- Redis -----------------------------------
# Private network + TLS + auth. Used for rate limiting, presence, sessions,
# sockets and job coordination. Never expose publicly.
REDIS_URL=rediss://:CHANGE_ME_redis_password@HOST:6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_TLS=true
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=noeviction

# ---------------- API / Server ----------------------------
# PORT is injected by the host platform (Render). When unset locally, the API
# falls back to API_PORT (default 4000). Do NOT hard-code a Render port here.
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=https://vuzki-api.onrender.com

# ---------------- URLs (approved origins only) ------------
# Single-frontend topology: apps/web serves both the website and the app
# on https://vuzki.app, so BOTH here and in CORS_ORIGINS point at vuzki.app.
WEB_URL=https://vuzki.app
ADMIN_URL=https://admin.vuzki.app
WEBSITE_URL=https://vuzki.app
# Comma separated list of approved CORS origins (must include the frontend).
CORS_ORIGINS=https://vuzki.app,https://admin.vuzki.app
CORS_CREDENTIALS=true

# ---------------- Secrets (use a secret manager in prod) --
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_random_chars_for_production
JWT_REFRESH_SECRET=CHANGE_ME_64_random_chars_for_refresh
SESSION_SECRET=CHANGE_ME_64_random_chars_for_sessions
# Separately signs admin tokens. Required in production (API fails fast if unset).
ADMIN_JWT_SECRET=CHANGE_ME_64_random_chars_for_admin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Secret Manager references (replace direct secrets above when integrating)
# SECRETS_MANAGER_ARN=arn:aws:secretsmanager:region:acct:secret:vuzki/production

# ---------------- Rate limiting ---------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ---------------- Email / OTP -----------------------------
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
FROM_EMAIL=no-reply@vuzki.app
OTP_PROVIDER=twilio   # dev | twilio | msg91
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_SERVICE_SID=CHANGE_ME

# ---------------- OAuth -----------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
APPLE_CLIENT_ID=CHANGE_ME
APPLE_TEAM_ID=CHANGE_ME
APPLE_KEY_ID=CHANGE_ME
APPLE_PRIVATE_KEY=CHANGE_ME

# ---------------- Payments --------------------------------
# demo | razorpay | cashfree | stripe | phonepe  (STAGING & PROD MUST NOT BE 'demo')
PAYMENT_PROVIDER=razorpay
DEMO_MODE=false
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
CASHFREE_CLIENT_ID=CHANGE_ME
CASHFREE_CLIENT_SECRET=CHANGE_ME
# Shared secret authenticating provider webhooks / signing keys (non-demo fulfillment).
WEBHOOK_SECRET=CHANGE_ME
# PhonePe
PHONEPE_MERCHANT_ID=CHANGE_ME
PHONEPE_CLIENT_ID=CHANGE_ME
PHONEPE_CLIENT_SECRET=CHANGE_ME
PHONEPE_SALT_KEY=CHANGE_ME
PHONEPE_SALT_INDEX=1

# ---------------- RTC / Calls -----------------------------
# webrtc | twilio | agora | livekit
RTC_PROVIDER=livekit
LIVEKIT_URL=wss://rtc.vuzki.app
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
TWILIO_API_KEY=CHANGE_ME
TWILIO_API_SECRET=CHANGE_ME
AGORA_APP_ID=CHANGE_ME
AGORA_APP_CERTIFICATE=CHANGE_ME
# TURN relay (for restrictive NATs / firewalls)
TURN_URL=turns:turn.vuzki.app:5349
TURN_USERNAME=CHANGE_ME
TURN_CREDENTIAL=CHANGE_ME

# ---------------- Object Storage / CDN --------------------
# local | s3  (production should use S3-compatible object storage + CDN)
STORAGE_PROVIDER=s3
UPLOAD_DIR=uploads
S3_BUCKET=vuzki-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=
CDN_BASE_URL=https://cdn.vuzki.app

# ---------------- Push notifications ----------------------
# off | fcm | apns | onesignal
PUSH_PROVIDER=fcm
FCM_SERVER_KEY=CHANGE_ME
ONESIGNAL_APP_ID=CHANGE_ME
ONESIGNAL_REST_KEY=CHANGE_ME

# ---------------- AI moderation ---------------------------
# off | openai | local
AI_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
AI_MODERATION_MODEL=openai:moderation-latest
AI_MODERATION_VERSION=v1
IMAGE_MODERATION_ENABLED=true
IMAGE_MODERATION_PROVIDER=openai
SAFETY_RISK_ENABLED=true
FRAUD_DETECTION_ENABLED=true
BOT_DETECTION_ENABLED=true
RETENTION_ENABLED=true

# ---------------- Analytics / Monitoring ------------------
# off | posthog | mixpanel | amplitude
ANALYTICS_PROVIDER=posthog
POSTHOG_KEY=CHANGE_ME
POSTHOG_HOST=https://us.i.posthog.com
MIXPANEL_TOKEN=CHANGE_ME
AMPLITUDE_KEY=CHANGE_ME
# Error tracking
SENTRY_DSN=CHANGE_ME

# ---------------- Feature flags ---------------------------
# Each can be toggled per environment; also controllable at runtime via admin API.
FEATURE_TALK_NOW=true
FEATURE_VIDEO_CALLS=true
FEATURE_NEW_MATCHING=false
FEATURE_PROMOTIONS=false
FEATURE_GIFTS=true
FEATURE_CREATOR_FEATURES=true
FEATURE_SUBSCRIPTIONS=true

# ---------------- Currency / Pricing ----------------------
CURRENCY=INR
SUPER_LIKE_COST=30
REFERRAL_REWARD=50
BOOST_30_MIN=50
BOOST_1_HOUR=90
BOOST_3_HOUR=200
DAILY_REWARD_DEFAULT=5

# ---------------- Host ports (docker compose dev) ---------
WEB_PORT=3000
ADMIN_PORT=3001

# ---------------- Staging / production deploy ------------
# TEST_MODE=false
# SEED_ADMIN_EMAIL=admin@vuzki.app
# SEED_ADMIN_PASSWORD=CHANGE_ME (one-time bootstrap, rotated after first login)

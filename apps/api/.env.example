# =====================================================================
# VUZKI API - Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================================

# ---- Server ----
# PORT is injected by the host platform (Render). When unset locally, the API
# falls back to API_PORT (default 4000). Do NOT hard-code a Render port here.
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# ---- URLs ----
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_random_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_random_chars
# Separately signs admin tokens. Required in production (API fails fast if unset).
ADMIN_JWT_SECRET=CHANGE_ME_64_random_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vuzki

# ---- Redis (optional, for scaling) ----
REDIS_URL=

# ---- SMTP / Email OTP ----
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@vuzki.app

# ---- OTP Provider (dev | twilio) ----
OTP_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ---- Google / Apple OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- Payments (demo | razorpay | cashfree | stripe | phonepe) ----
PAYMENT_PROVIDER=demo
DEMO_MODE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Shared secret authenticating provider webhooks / signing keys (non-demo fulfillment).
WEBHOOK_SECRET=

# PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# ---- RTC / Calls (webrtc | twilio | agora | livekit) ----
RTC_PROVIDER=webrtc
TWILIO_API_KEY=
TWILIO_API_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# TURN via Twilio Network Traversal Service (short-lived per-user NTS tokens).
# Server-side only; uses the same TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN as OTP
# below. The browser never sees these permanent credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Storage (local | s3) ----
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ---- AI Moderation (off | openai | local) ----
AI_PROVIDER=off
OPENAI_API_KEY=

# ---- Currency ----
CURRENCY=INR

# ---- Monetization pricing (server-side, overridable via env) ----
SUPER_LIKE_COST=30
REFERRAL_REWARD=50
BOOST_30_MIN=50
BOOST_1_HOUR=90
BOOST_3_HOUR=200
DAILY_REWARD_DEFAULT=5

# ---- Server / Logging ----
API_HOST=0.0.0.0
API_PUBLIC_URL=https://api.vuzki.app
LOG_LEVEL=info                # debug | info | warn | error

# ---- Sessions / CORS ----
SESSION_SECRET=CHANGE_ME_64_random_chars
CORS_ORIGINS=https://vuzki.app,https://admin.vuzki.app
CORS_CREDENTIALS=true

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ---- Push notifications (off | fcm | apns | onesignal) ----
PUSH_PROVIDER=off
FCM_SERVER_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# ---- Analytics (off | posthog | mixpanel | amplitude) ----
ANALYTICS_PROVIDER=off
POSTHOG_KEY=
POSTHOG_HOST=
MIXPANEL_TOKEN=
AMPLITUDE_KEY=

# ---- Error tracking ----
SENTRY_DSN=

# ---- Feature flags (per environment; togglable via admin API) ----
FEATURE_TALK_NOW=true
FEATURE_VIDEO_CALLS=true
FEATURE_NEW_MATCHING=false
FEATURE_PROMOTIONS=false
FEATURE_GIFTS=true
FEATURE_CREATOR_FEATURES=true
FEATURE_SUBSCRIPTIONS=true

# ---- Build metadata ----
BUILD_ID=

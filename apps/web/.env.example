# VUZKI Web (Next.js) - public client environment template.
# Copy to .env and set per environment. NEVER commit .env.
#
# SECURITY: Only NEXT_PUBLIC_* values are safe in the browser bundle. Never put
# API keys, payment secrets, JWT secrets, DB credentials or private keys here -
# those live server-side only (API), referenced by ENV var names, not values.

# Public API base URL (baked at build time). Same-origin: the consolidated
# server serves /api/v1 on the SAME host as the website. Leave as a bare
# path (e.g. just /api/v1) for true same-origin, or set the full origin.
NEXT_PUBLIC_API_URL=https://vuzki.app/api/v1

# Public Socket.IO endpoint for realtime (chat, calls, presence). Same-origin:
# /socket.io is served on the SAME host. Empty string (or omitted) means the
# browser connects to window.location's origin — the consolidated default.
NEXT_PUBLIC_SOCKET_URL=https://vuzki.app

# Public branding / analytics identifiers (non-secret).
NEXT_PUBLIC_APP_NAME=VUZKI
NEXT_PUBLIC_SITE_URL=https://vuzki.app
NEXT_PUBLIC_ANALYTICS_PROVIDER=off

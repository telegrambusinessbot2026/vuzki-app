# VUZKI Admin (Next.js admin panel) - public client environment template.
# Copy to .env and set per environment. NEVER commit .env.
#
# SECURITY: Admin is a privileged surface. All authorization is enforced
# server-side by the API. Never place admin secrets / credentials here -
# only non-secret public values.

# Public API base URL (baked at build time).
NEXT_PUBLIC_API_URL=https://api.vuzki.app/api/v1

# Admin panel branding.
NEXT_PUBLIC_APP_NAME=VUZKI Admin
NEXT_PUBLIC_SITE_URL=https://admin.vuzki.app

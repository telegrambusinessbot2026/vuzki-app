# VUZKI Public Website (marketing / landing) - public environment template.
# Copy to .env and set per environment. NEVER commit .env.

# Canonical site URL (used for metadata / SEO).
NEXT_PUBLIC_SITE_URL=https://vuzki.app

# Public API base URL (for any interactive marketing widgets).
NEXT_PUBLIC_API_URL=https://api.vuzki.app/api/v1

# App store / play store deep links (public, non-secret).
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
